# Shared passcode both founders type at login (pick something long).
TEEM_PASSCODE=

# Signs the session cookie. Any long random string: `openssl rand -base64 32`
TEEM_SECRET=

# Postgres. Added automatically when you connect Neon in Vercel → Storage.
# Leave empty locally to use the built-in PGlite database in ./.pglite
DATABASE_URL=
